# Database
DATABASE_URL=postgresql://veritas:veritas_pass@postgres:5432/veritas_db

# Redis
REDIS_URL=redis://redis:6379/0

# LLM Configuration
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
LLM_PROVIDER=openai  # openai, anthropic, azure
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0

# External APIs
GOOGLE_MAPS_API_KEY=your-google-maps-key
OPENCORPORATES_API_KEY=your-opencorporates-key
LEXISNEXIS_API_KEY=your-lexisnexis-key

# Security
AGENCY_TOKEN=dev-token-12345
SECRET_KEY=your-secret-key-for-jwt

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
