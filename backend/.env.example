# ===== REQUIRED CONFIGURATION =====

# Database
DATABASE_URL=postgresql://veritas:veritas_pass@postgres:5432/veritas_db

# Redis
REDIS_URL=redis://redis:6379/0

# LLM Configuration (REQUIRED - Choose one provider)
OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
LLM_PROVIDER=openai  # openai, anthropic, azure
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0

# Security (REQUIRED - Change in production!)
AGENCY_TOKEN=dev-token-12345
SECRET_KEY=your-secret-key-for-jwt  # Generate with: openssl rand -hex 32

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# ===== OPTIONAL: EXTERNAL DATA SOURCES =====

# Layer 1: Physical Verification
GOOGLE_MAPS_API_KEY=  # Optional - uses mock data if not provided

# Layer 2: Corporate Verification
OPENCORPORATES_API_KEY=  # Optional - uses mock data if not provided
SEC_EDGAR_ENABLED=true  # Free alternative for US companies

# ===== LAYER 3: IDENTITY VERIFICATION =====
# LexisNexis is OPTIONAL - Most clients won't have access
# Use free/cheap alternatives below instead

# Option 1: Disable LexisNexis (Recommended)
ENABLE_LEXISNEXIS=false
# LEXISNEXIS_API_KEY=
# LEXISNEXIS_ENDPOINT=

# Phone Verification (choose one provider)
PHONE_VERIFICATION_PROVIDER=pattern  # Options: twilio, numverify, pattern, lexisnexis

# Twilio (Recommended - $0.005 per lookup)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# NumVerify (Free tier: 250/month)
# NUMVERIFY_API_KEY=

# Pattern matching (Free - basic VOIP detection)
# No API key needed

# Email Verification (choose one provider)
EMAIL_VERIFICATION_PROVIDER=hibp  # Options: hibp, emailrep, google, lexisnexis

# Have I Been Pwned (Free for non-commercial use)
HIBP_API_KEY=  # Free - request at https://haveibeenpwned.com/API/Key

# EmailRep.io (Free tier: 250/day)
# EMAILREP_API_KEY=

# Google Custom Search (Free tier: 100/day)
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX=

# Breach History (uses same provider as email)
BREACH_VERIFICATION_PROVIDER=hibp

# ===== LAYER 5: CROSS-CASE INTELLIGENCE =====

# Vector & Graph Databases (included in Docker Compose)
CHROMA_URL=http://chromadb:8000
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=veritas_graph_pass

# Employee Ghost Check
ENABLE_GHOST_CHECK=true
DMF_SOURCE=direct  # Options: direct, lexisnexis, disabled

# SSA Death Master File (free download or $50 from NTIS)
# Download from: https://www.ssdmf.com/Library/Home/DownloadLatest
DMF_FILE_PATH=/data/ssdmf.txt

# ===== NOTES =====
# 1. Only OpenAI/Anthropic API key is REQUIRED
# 2. LexisNexis is OPTIONAL - use free alternatives
# 3. Layers 4 & 5 work completely offline (no external APIs needed)
# 4. Mock data is used automatically when API keys are not provided
